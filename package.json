{
  "name": "get-version-action",
  "version": "1.1.0",
  "description": "A GitHub Action which extracts the version from github.ref.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "package": "npm run package:get-version && npm run package:create-release",
    "package:get-version": "esbuild src/index.ts --bundle --format=cjs --platform=node --target=node20 --outfile=dist/index.js",
    "package:create-release": "esbuild src/createRelease/index.ts --bundle --format=cjs --platform=node --target=node20 --outfile=create-release/dist/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:version": "node ./dist/index.js",
    "test:runtime-smoke": "node ./test/runtime-smoke.js && node ./test/runtime-smoke-create-release.js",
    "updateAll": "npx npm-check -u",
    "prepare": "husky install",
    "precommit": "npm run build && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easylife365/get-version-action.git"
  },
  "author": "EasyLife 365 AG",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/easylife365/get-version-action/issues"
  },
  "homepage": "https://github.com/easylife365/get-version-action#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "child_process": "^1.0.2",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.5",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vercel/ncc": "^0.38.4",
    "esbuild": "^0.28.1",
    "eslint-config-standard": "^17.1.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.4.0",
    "standard": "^17.1.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
